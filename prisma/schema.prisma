generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int    @id @default(autoincrement())
  title       String @unique
  description String
  image       String
  price       Float
  material    String
  published   Boolean @default(true)
}

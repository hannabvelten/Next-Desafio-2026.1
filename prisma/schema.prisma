datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          Int     @id @default(autoincrement())
  title       String  @unique
  description String
  image       String?
  price       Float
  material    String
  published   Boolean @default(true)
}

